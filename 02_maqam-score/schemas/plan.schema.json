{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.local/maqam-score/plan.schema.json",
  "title": "OSTRIS skill_plan.json",
  "description": "The 15 targets checker.py requires, plus provenance. brief.json is the human-facing companion.",
  "type": "object",
  "required": [
    "key",
    "tempo",
    "meter",
    "unit",
    "bars",
    "syllables",
    "sections",
    "melisma_min",
    "melisma_max",
    "register",
    "max_top_duration_share",
    "min_distinct_durations",
    "ties_min",
    "min_fill_notes",
    "chords_min"
  ],
  "properties": {
    "plan_version": { "type": "string" },
    "key": { "type": "string", "minLength": 1 },
    "tempo": { "type": "number", "exclusiveMinimum": 0 },
    "meter": { "type": "string", "pattern": "^[0-9]+/[0-9]+$" },
    "unit": { "type": "string", "pattern": "^1/[0-9]+$" },
    "bars": { "type": "integer", "minimum": 1 },
    "syllables": { "type": "integer", "minimum": 1 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "section_bars": { "type": "array", "items": { "type": "integer", "minimum": 2 } },
    "melisma_min": { "type": "number", "minimum": 0.5 },
    "melisma_max": { "type": "number", "maximum": 2.0 },
    "register": {
      "type": "object",
      "required": ["mean", "top", "tolerance"],
      "properties": {
        "mean": { "type": "integer" },
        "top": { "type": "integer" },
        "max_top": { "type": "integer" },
        "tolerance": { "type": "number", "minimum": 0 }
      }
    },
    "tessitura_share_ge_c5_max": { "type": "number", "minimum": 0, "maximum": 1 },
    "chorus_lift_min": { "type": "number" },
    "strict_shape": { "type": "boolean" },
    "max_top_duration_share": { "type": "number", "minimum": 0, "maximum": 1 },
    "min_distinct_durations": { "type": "integer", "minimum": 1 },
    "ties_min": { "type": "integer", "minimum": 0 },
    "min_fill_notes": { "type": "integer", "minimum": 0 },
    "chords_min": { "type": "integer", "minimum": 0 },
    "max_unbroken_seconds": { "type": "number", "exclusiveMinimum": 0 },
    "min_phrase_endings": { "type": "integer", "minimum": 1 },
    "maqam_fit_min": { "type": "number", "minimum": 0, "maximum": 1 },
    "voices": { "type": "string", "const": "vocal+ins" },
    "cadence": { "type": "string" },
    "deviations": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["bars", "channel", "before", "after"],
            "properties": {
              "bars": { "type": "string" },
              "channel": { "type": "string" },
              "before": { "type": "string" },
              "after": { "type": "string" },
              "assert": {
                "type": "object",
                "required": ["metric", "range", "op", "value"],
                "properties": {
                  "metric": {
                    "type": "string",
                    "enum": [
                      "answer_rate",
                      "ins_notes_per_bar",
                      "vocal_notes_per_bar",
                      "vocal_median_pitch",
                      "ins_active_share",
                      "silence_share"
                    ]
                  },
                  "range": { "type": "string", "minLength": 1 },
                  "op": {
                    "type": "string",
                    "enum": ["<", "<=", ">", ">=", "==", "=", "!=", "between", "in"]
                  },
                  "value": {
                    "oneOf": [
                      { "type": "number" },
                      {
                        "type": "array",
                        "minItems": 2,
                        "maxItems": 2,
                        "items": { "type": "number" }
                      }
                    ]
                  }
                }
              },
              "unverifiable": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "copies": {
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "entries"],
          "properties": {
            "status": { "type": "string", "const": "unfilled" },
            "entries": { "type": "array" }
          }
        },
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": { "type": "string", "const": "independent" },
              "of_bars": { "type": "string" },
              "bars": { "type": "string" },
              "voices": {
                "oneOf": [
                  { "type": "string", "enum": ["Vocal", "Ins"] },
                  {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "enum": ["Vocal", "Ins"] }
                  }
                ]
              },
              "changes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {
                    "bar": { "type": "integer", "minimum": 1 },
                    "bars": { "type": "string" },
                    "voice": { "type": "string", "enum": ["Vocal", "Ins"] },
                    "kind": {
                      "type": "string",
                      "enum": ["octave", "ornament", "cadence", "density", "truncation", "other"]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "arrangement": {
      "type": "object",
      "properties": {
        "status": { "type": "string", "const": "unfilled" },
        "section_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["bars"],
            "properties": {
              "bars": { "type": "string" },
              "role": { "type": "string" },
              "vocal_notes_per_bar": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0 }
              },
              "ins_notes_per_bar": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0 }
              },
              "ins_active_share": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0, "maximum": 1 }
              },
              "answer_rate": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          }
        },
        "ins_entries": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "integer", "minimum": 1 },
              {
                "type": "object",
                "required": ["bar"],
                "properties": {
                  "bar": { "type": "integer", "minimum": 1 },
                  "tolerance_bars": { "type": "integer", "minimum": 0 }
                }
              }
            ]
          }
        }
      }
    },
    "allow_unmarked": { "type": "array", "items": { "type": "string" } },
    "max_excess_notes_per_line": { "type": "integer", "minimum": 0 },
    "maqam": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["name", "tonic", "degrees"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "tonic": { "type": "string", "minLength": 1 },
            "degrees": {
              "type": "array",
              "minItems": 5,
              "items": { "type": "string", "minLength": 1 }
            },
            "resting": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      ]
    },
    "maqam_conditioned": { "type": "boolean", "const": false },
    "source": {
      "type": "object",
      "required": ["prior", "n", "confidence"],
      "properties": {
        "prior": { "type": "string" },
        "n": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "string" },
        "backoff": { "type": "array", "items": { "type": "string" } }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
