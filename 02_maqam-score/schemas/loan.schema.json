{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.local/maqam-score/loan.schema.json",
  "title": "Declared borrowing record",
  "description": "The composer's loans.json: every borrowed asset must state what was borrowed, how it was transformed, and why it fits the section.",
  "type": "object",
  "required": ["loans"],
  "properties": {
    "loans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "borrowed", "fit", "transform", "why"],
        "properties": {
          "asset": { "type": "string", "pattern": "^a-" },
          "source": { "type": "string" },
          "bars": {
            "oneOf": [
              { "type": "string", "pattern": "^[0-9]+(-[0-9]+)?$" },
              { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "integer" } }
            ]
          },
          "borrowed": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["rhythm", "contour", "cadence", "interval", "duration",
                       "groove", "chord", "structure", "cell"]
            }
          },
          "role": { "type": "string" },
          "fit": {
            "type": "object",
            "minProperties": 2,
            "additionalProperties": true
          },
          "transform": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 }
          },
          "why": { "type": "string", "minLength": 20 },
          "risk": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
