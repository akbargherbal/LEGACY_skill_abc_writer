{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skill.local/abc-remixer/remix_block.schema.json",
  "title": "abc_remixer plan remix block",
  "type": "object",
  "required": ["concept", "sources"],
  "properties": {
    "concept": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "from_bars", "to_bars", "voice"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "from_bars": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"},
          "to_bars": {"type": "string", "pattern": "^[0-9]+(-[0-9]+)?(,[0-9]+(-[0-9]+)?)*$"},
          "transform": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "voice": {"type": "string", "enum": ["Vocal", "Ins", "both"]}
        },
        "additionalProperties": true
      }
    },
    "literal_cap_bars": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": true
}
